<Window x:Class="GoreBox.Views.Dialogs.SshCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,4">
            <TextBlock Text="Логин и пароль сохраняются за этим SSH-подключением." Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Логин" Style="{StaticResource TxtMuted}" />
                    <TextBox x:Name="UserBox" Style="{StaticResource InputBox}" Margin="0,4,0,0"
                             Tag="например, root" KeyDown="OnKeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Пароль" Style="{StaticResource TxtMuted}" />
                    <!-- PasswordBox не умеет биндиться к строке: значение забирает код окна -->
                    <PasswordBox x:Name="PwdBox" Style="{StaticResource InputPassword}" Margin="0,4,0,0"
                                 KeyDown="OnKeyDown" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
            <Button Content="Отмена" Style="{StaticResource BtnGhost}" Click="OnCancel" />
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
