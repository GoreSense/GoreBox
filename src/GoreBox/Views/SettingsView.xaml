<UserControl x:Class="GoreBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="Настройки" Style="{StaticResource TxtH1}" HorizontalAlignment="Center" />
            <TextBlock Text="Тема, автозапуск, SSH, место хранения данных и ядро sing-box."
                       Style="{StaticResource TxtMuted}" Margin="0,3,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16" MaxWidth="760" HorizontalAlignment="Center">

                <!-- ==================== внешний вид и поведение ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Внешний вид и поведение" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Тёмная тема" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding IsDark}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14" />

                        <Grid>
                            <TextBlock Text="Запускать при входе в Windows" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding RunAtStartup}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Запускать свёрнутым в трей" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding StartMinimized}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Закрывать окно в трей" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Запоминать состояние при выходе" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding RememberState}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="При запуске будет выбран тот же профиль, и прокси включится, если он был активен при закрытии." />

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Точный замер задержки через ядро" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding PreciseLatencyTest}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Использует API ядра для реального времени ответа сервера. Без ядра измеряется TCP/ICMP." />
                    </StackPanel>
                </Border>

                <!-- ==================== ядро ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Ядро sing-box" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{Binding CoreVersionText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Проверить" Style="{StaticResource BtnGhost}" Command="{Binding CheckCoreCommand}" />
                                <Button Content="Взять встроенное" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                        Command="{Binding RestoreBundledCoreCommand}" />
                                <Button Content="Обновить с GitHub" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                        Command="{Binding InstallCoreCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CorePathText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CoreSupportText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BundledCoresText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Расширенная сборка (AmneziaWG, XHTTP)" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsExtendedFlavor}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Официальный sing-box или расширенная сборка (sing-box-extended). Расширенная нужна для AmneziaWG; обе идут в комплекте и распаковываются автоматически." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Указать файл ядра" Style="{StaticResource BtnGhost}" Command="{Binding ChooseCoreFileCommand}" />
                            <Button Content="Установить из архива" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding InstallFromFileCommand}" />
                            <Button Content="Папка ядра" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="core" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== SSH ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SSH" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Логин и пароль для вкладки SSH. Если логин заполнен, он используется вместо user@ из адреса. Если поля пусты, вкладка спросит при подключении." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Логин" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="например, root"
                                         Text="{Binding SshLogin, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Пароль" Style="{StaticResource TxtMuted}" />
                                <!-- PasswordBox не умеет биндиться к паролю: значение синхронизирует код окна -->
                                <PasswordBox x:Name="SshPasswordBox" Style="{StaticResource InputPassword}" Margin="0,4,0,0"
                                             PasswordChanged="OnSshPasswordChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== данные ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Данные приложения" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Профили и наборы правил хранятся отдельными json-файлами: профили — profiles\, правила — routes\. Файлы наборов можно копировать на другое устройство." />

                        <!-- место хранения: выбирается здесь, вступает в силу после перезапуска -->
                        <TextBlock Text="Место хранения данных" Style="{StaticResource TxtCaption}" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding CurrentDataRootText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}" Content="В локальной папке"
                                     IsChecked="{Binding StorageIsLocal}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding LocalDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}"
                                     Content="Рядом с исполняемым файлом (по умолчанию)"
                                     IsChecked="{Binding StorageIsExe}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ExeDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}" Content="Указать своё место"
                                         IsChecked="{Binding StorageIsCustom}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Выбрать…" Style="{StaticResource BtnGhost}"
                                    Command="{Binding ChooseCustomFolderCommand}"
                                    Visibility="{Binding IsCustomStorage, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding CustomDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <TextBlock Text="{Binding StorageNoticeText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="{Binding HasStorageNotice, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,10,0,0" Visibility="{Binding StoragePending, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StoragePendingText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Перезапустить" Style="{StaticResource BtnPrimary}" Margin="12,0,0,0"
                                    Command="{Binding RestartNowCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Открыть папку данных" Style="{StaticResource BtnGhost}"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="root" />
                            <Button Content="Открыть логи" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="logs" />
                            <Button Content="Сбросить настройки" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Command="{Binding ResetSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
